
## FIGURE

figure.titlesize   : 350     # size of the figure title
figure.titleweight : normal     # weight of the figure title
figure.figsize     : 11, 6      # figure size in inches
figure.dpi         : 100        # figure dots per inch
figure.autolayout  : False      # When True, automatically adjust subplot
figure.frameon     : True

figure.subplot.left    : 0.08  # the left side of the subplots of the figure
figure.subplot.right   : 0.96    # the right side of the subplots of the figure
figure.subplot.bottom  : 0.1   # the bottom of the subplots of the figure
figure.subplot.top     : 0.95    # the top of the subplots of the figure

## LINES

lines.linewidth : 2.5
lines.markersize : 8.0

## AXES
axes.facecolor             : "f9f9f9"       # axes background color
axes.edgecolor             : "f5f5f5"        # axes edge color
axes.linewidth              : 3.5          # edge linewidth
axes.labelcolor             : black
axes.prop_cycle             : cycler(color=["1395ba", "#a2b86c", "c02e1d", "ebc844","#6a0177", "f16c20"])
axes.axisbelow              : True

axes.formatter.use_mathtext : True # When True, use mathtext for scientific notation
axes.labelsize : 18
axes.labelweight: normal

## GRID

axes.grid      : True
grid.color     : "white"
grid.linestyle : solid
grid.linewidth : 3
grid.alpha     : 1

## LEGEND

legend.fancybox  : True
legend.facecolor : white
legend.fontsize : 15

## TICKS

xtick.direction : out
ytick.direction : out
xtick.labelsize : 17
ytick.labelsize : 17
xtick.major.size     : 5      # major tick size in points
xtick.major.width    : 2      # major tick width in points
ytick.major.size     : 5      # major tick size in points
ytick.major.width    : 2      # major tick width in points


## IMAGES
image.aspect : equal
image.cmap   : jet

## TEXT

text.color          : k
text.usetex         : False

## SAVEFIG

savefig.transparent : False
